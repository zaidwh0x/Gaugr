<file path="Gaugr/Gaugr.App/ViewModels/ProcessesViewModel.cs">
using CommunityToolkit.Mvvm.ComponentModel;
using CommunityToolkit.Mvvm.Input;
using Gaugr.App.Services;
using System.Collections.ObjectModel;
using System.Globalization;
using System.Windows.Threading;

namespace Gaugr.App.ViewModels;

public partial class ProcessesViewModel : ObservableObject
{
    private readonly ProcessSampler _sampler = new();
    private readonly DispatcherTimer _timer = new() { Interval = TimeSpan.FromSeconds(2) };
    private List<ProcessInfo> _all = new();
    private bool _busy;

    [ObservableProperty] private string _search = "";
    [ObservableProperty] private string _sortBy = "Memory";   // Name / CPU / Memory
    [ObservableProperty] private string _summary = "";

    public ObservableCollection<ProcessInfo> Processes { get; } = new();

    public ProcessesViewModel()
    {
        _timer.Tick += async (_, _) => await RefreshAsync();
    }

    // Only sample while the Processes page is on screen
    public void SetActive(bool active)
    {
        if (active)
        {
            _timer.Start();
            _ = RefreshAsync();
        }
        else
        {
            _timer.Stop();
        }
    }

    partial void OnSearchChanged(string value) => Apply();
    partial void OnSortByChanged(string value) => Apply();

    [RelayCommand]
    private void SetSort(string by) => SortBy = by;

    private async Task RefreshAsync()
    {
        if (_busy) return;
        _busy = true;
        try
        {
            _all = await Task.Run(_sampler.Sample);   // heavy work off the UI thread
            Apply();
        }
        finally { _busy = false; }
    }

    private void Apply()
    {
        IEnumerable<ProcessInfo> items = _all;

        var text = Search.Trim();
        if (text.Length > 0)
            items = items.Where(p => p.Name.Contains(text, StringComparison.OrdinalIgnoreCase));

        items = SortBy switch
        {
            "Name" => items.OrderBy(p => p.Name, StringComparer.OrdinalIgnoreCase),
            "CPU" => items.OrderByDescending(p => p.Cpu),
            _ => items.OrderByDescending(p => p.MemoryMb)
        };

        var list = items.ToList();
        Sync(list);
        Summary = $"{list.Count} apps  ·  {list.Sum(p => p.MemoryMb) / 1024:0.0} GB of memory";
    }

    // Updates rows in place so the list doesn't jump back to the top every 2 seconds
    private void Sync(List<ProcessInfo> items)
    {
        for (int i = 0; i < items.Count; i++)
        {
            if (i < Processes.Count) Processes[i] = items[i];
            else Processes.Add(items[i]);
        }
        while (Processes.Count > items.Count)
            Processes.RemoveAt(Processes.Count - 1);
    }
}
</file>

<file path="Gaugr/Gaugr.App/ViewModels/StorageViewModel.cs">
using System.Collections.ObjectModel;
using System.IO;
using System.Windows.Media;
using CommunityToolkit.Mvvm.ComponentModel;

namespace Gaugr.App.ViewModels;

public sealed class DriveItem
{
    private static readonly Brush Healthy = Frozen(79, 195, 255);
    private static readonly Brush Busy = Frozen(255, 210, 60);
    private static readonly Brush Critical = Frozen(255, 90, 31);

    public DriveItem(string name, string label, string format, string kind, double totalBytes, double freeBytes)
    {
        UsedPercent = totalBytes > 0 ? (totalBytes - freeBytes) / totalBytes * 100 : 0;

        Title = string.IsNullOrWhiteSpace(label) ? name : $"{name}  {label}";
        Detail = $"{FormatSize(freeBytes)} free of {FormatSize(totalBytes)}  ·  {format}  ·  {kind}";
        UsageBrush = UsedPercent >= 90 ? Critical : UsedPercent >= 75 ? Busy : Healthy;
        StatusText = UsedPercent >= 90 ? "Almost full. Free up some space to keep Windows running smoothly." : "";
    }

    public string Title { get; }
    public string Detail { get; }
    public string StatusText { get; }
    public double UsedPercent { get; }
    public Brush UsageBrush { get; }

    private static string FormatSize(double bytes)
    {
        double gb = bytes / 1_073_741_824.0;
        return gb >= 1024 ? $"{gb / 1024:0.##} TB" : $"{gb:0} GB";
    }

    private static SolidColorBrush Frozen(byte r, byte g, byte b)
    {
        var brush = new SolidColorBrush(Color.FromRgb(r, g, b));
        brush.Freeze();
        return brush;
    }
}

public partial class StorageViewModel : ObservableObject
{
    public ObservableCollection<DriveItem> Drives { get; } = new();

    public StorageViewModel() => Refresh();

    public void Refresh()
    {
        Drives.Clear();

        foreach (var drive in DriveInfo.GetDrives())
        {
            if (drive.DriveType is not (DriveType.Fixed or DriveType.Removable)) continue;

            try
            {
                if (!drive.IsReady) continue;

                Drives.Add(new DriveItem(
                    drive.Name.TrimEnd('\\'),
                    drive.VolumeLabel,
                    drive.DriveFormat,
                    drive.DriveType == DriveType.Removable ? "Removable" : "Local disk",
                    drive.TotalSize,
                    drive.AvailableFreeSpace));
            }
            catch (IOException) { /* drive disappeared or is not accessible */ }
            catch (UnauthorizedAccessException) { }
        }
    }
}
