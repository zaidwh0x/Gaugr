                               Text="{Binding Health, StringFormat={}{0:0}%}"
                               Foreground="White" FontSize="22" FontWeight="SemiBold"/>

                    <controls:VerticalMeter Grid.Row="3" Margin="12,16,0,0" HorizontalAlignment="Left"
                                            Width="68" Value="{Binding Health}"/>
