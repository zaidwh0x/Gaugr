<file path="Gaugr/Gaugr.App/Services/MonitorHub.cs">
using System.Windows.Threading;

namespace Gaugr.App.Services;

public sealed class MonitorHub : IDisposable
{
    public const int HistoryLength = 600;   // 5 minutes at the fastest refresh rate (2 samples per second)

    private readonly SettingsService _settings;
    private readonly HardwareMonitorService _hardware = new();
    private readonly DispatcherTimer _timer = new();
    private readonly List<HardwareSnapshot> _history = new();
    private bool _busy;

    public MonitorHub(SettingsService settings)
    {
        _settings = settings;
        _timer.Interval = TimeSpan.FromSeconds(settings.RefreshSeconds);
        settings.Changed += OnSettingsChanged;
    }

    public HardwareSnapshot? Latest { get; private set; }
    public IReadOnlyList<HardwareSnapshot> History => _history;
    public double IntervalSeconds => _timer.Interval.TotalSeconds;

    public event Action<HardwareSnapshot>? Updated;
    public event Action? IntervalChanged;

    public void Start()
    {
        _timer.Tick += async (_, _) => await TickAsync();
        _timer.Start();
        _ = TickAsync();
    }

    private void OnSettingsChanged()
    {
        var interval = TimeSpan.FromSeconds(_settings.RefreshSeconds);
        if (interval == _timer.Interval) return;

        _timer.Interval = interval;
        _history.Clear();   // samples taken at a different rate would distort the graph windows
        IntervalChanged?.Invoke();
    }

    private async Task TickAsync()
    {
        if (_busy) return;
        _busy = true;
        try
        {
            var snap = await Task.Run(_hardware.Read);   // sensors read off the UI thread

            Latest = snap;                               // everything below runs on the UI thread
            _history.Add(snap);
            if (_history.Count > HistoryLength) _history.RemoveAt(0);
            Updated?.Invoke(snap);
        }
        finally { _busy = false; }
    }

    public void Dispose()
    {
        _timer.Stop();
        _hardware.Dispose();
    }
}
</file>

<file path="Gaugr/Gaugr.App/Services/StartupService.cs">
using System.Diagnostics;
using System.IO;
using System.Security;
using System.Text;

namespace Gaugr.App.Services;

/// <summary>
/// Starts Gaugr at sign-in through a scheduled task. A plain Run registry entry cannot
/// launch an app that requires administrator rights, so a highest-privilege task is used.
/// </summary>
public sealed class StartupService
{
    private const string TaskName = "Gaugr";

    public bool IsEnabled() => RunSchtasks($"/Query /TN \"{TaskName}\"") == 0;

    public bool Enable()
    {
        var exe = Environment.ProcessPath;
        if (string.IsNullOrEmpty(exe)) return false;

        var xmlPath = Path.Combine(Path.GetTempPath(), "gaugr-startup-task.xml");
        try
        {
            File.WriteAllText(xmlPath, BuildTaskXml(exe), Encoding.Unicode);
            return RunSchtasks($"/Create /TN \"{TaskName}\" /XML \"{xmlPath}\" /F") == 0;
        }
        catch { return false; }
        finally
        {
            try { File.Delete(xmlPath); } catch { }
        }
    }

    public bool Disable() => !IsEnabled() || RunSchtasks($"/Delete /TN \"{TaskName}\" /F") == 0;

    // The XML form allows battery use and removes the default 72-hour limit, which the
    // command-line switches of schtasks cannot do.
    private static string BuildTaskXml(string exe)
    {
        var user = SecurityElement.Escape($"{Environment.UserDomainName}\\{Environment.UserName}");
        var command = SecurityElement.Escape(exe);
        var folder = SecurityElement.Escape(Path.GetDirectoryName(exe) ?? "");

        return $"""
            <?xml version="1.0" encoding="UTF-16"?>
            <Task version="1.4" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
              <Triggers>
                <LogonTrigger>
                  <Enabled>true</Enabled>
                  <UserId>{user}</UserId>
                </LogonTrigger>
              </Triggers>
              <Principals>
                <Principal id="Author">
                  <UserId>{user}</UserId>
                  <LogonType>InteractiveToken</LogonType>
                  <RunLevel>HighestAvailable</RunLevel>
                </Principal>
              </Principals>
              <Settings>
                <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
                <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
                <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
                <ExecutionTimeLimit>PT0S</ExecutionTimeLimit>
                <Enabled>true</Enabled>
              </Settings>
              <Actions Context="Author">
                <Exec>
                  <Command>{command}</Command>
                  <Arguments>--minimized</Arguments>
                  <WorkingDirectory>{folder}</WorkingDirectory>
                </Exec>
              </Actions>
            </Task>
            """;
    }

    private static int RunSchtasks(string arguments)
    {
        try
        {
            using var process = Process.Start(new ProcessStartInfo("schtasks.exe", arguments)
            {
                CreateNoWindow = true,
                UseShellExecute = false,
                RedirectStandardOutput = true,
                RedirectStandardError = true
            });
            if (process is null) return -1;

            process.StandardOutput.ReadToEnd();
            process.StandardError.ReadToEnd();
            process.WaitForExit();
            return process.ExitCode;
        }
        catch { return -1; }
    }
}
</file>

<file path="Gaugr/Gaugr.App/Services/TrayService.cs">
namespace Gaugr.App.Services;

/// <summary>The Gaugr icon in the Windows notification area, with its menu and balloon alerts.</summary>
public sealed class TrayService : IDisposable
{
    private readonly System.Windows.Forms.NotifyIcon _icon;
    private readonly System.Windows.Forms.ToolStripMenuItem _overlayItem;

    public TrayService()
    {
        var menu = new System.Windows.Forms.ContextMenuStrip();
        menu.Items.Add("Open Gaugr", null, (_, _) => OpenRequested?.Invoke());

        _overlayItem = new System.Windows.Forms.ToolStripMenuItem("Compact overlay");
        _overlayItem.Click += (_, _) => OverlayToggleRequested?.Invoke();
        menu.Items.Add(_overlayItem);

        menu.Items.Add(new System.Windows.Forms.ToolStripSeparator());
        menu.Items.Add("Exit", null, (_, _) => ExitRequested?.Invoke());

        _icon = new System.Windows.Forms.NotifyIcon
        {
            Icon = LoadIcon(),
            Text = "Gaugr",
            ContextMenuStrip = menu,
            Visible = true
        };

        _icon.MouseClick += (_, e) =>
        {
            if (e.Button == System.Windows.Forms.MouseButtons.Left) OpenRequested?.Invoke();
        };
    }

    public event Action? OpenRequested;
    public event Action? ExitRequested;
    public event Action? OverlayToggleRequested;

    public void SetOverlayChecked(bool value) => _overlayItem.Checked = value;

    public void Notify(string title, string message) =>
        _icon.ShowBalloonTip(6000, title, message, System.Windows.Forms.ToolTipIcon.Warning);

    // the exe carries the Gaugr icon, so reuse it
    private static System.Drawing.Icon LoadIcon()
    {
        try
        {
            var path = Environment.ProcessPath;
            if (path is not null && System.Drawing.Icon.ExtractAssociatedIcon(path) is { } icon) return icon;
        }
        catch { /* fall through to the generic icon */ }

        return System.Drawing.SystemIcons.Application;
    }

    public void Dispose()
    {
        _icon.Visible = false;   // otherwise Windows leaves a ghost icon until you hover over it
        _icon.Dispose();
    }
}
