<UserControl x:Class="Gaugr.App.Views.StorageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- dark, slim scrollbar -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" IsTabStop="False"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" IsTabStop="False"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="#2A3140" CornerRadius="4" Margin="2,0"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DriveBar" TargetType="ProgressBar">
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Background="#1A1D25" CornerRadius="5"/>
                            <Border x:Name="PART_Track">
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                        Background="{TemplateBinding Foreground}" CornerRadius="5"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="8,0,8,18">
            <TextBlock Text="Storage" Foreground="White" FontSize="14"/>
            <TextBlock Text="Your drives" Foreground="White" FontSize="38" FontWeight="Light"
                       Margin="0,22,0,0"/>
            <TextBlock Text="Capacity and free space on every disk Windows can see"
                       Foreground="#8A92A3" FontSize="15" Margin="0,4,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Drives}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="8,0,8,14" Padding="26,22" CornerRadius="22"
                                BorderBrush="#1C2028" BorderThickness="1">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#13151C" Offset="0"/>
                                    <GradientStop Color="#0C0E13" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Width="50" Height="50" CornerRadius="14" VerticalAlignment="Top"
                                        Background="#171A22" BorderBrush="#232733" BorderThickness="1">
                                    <TextBlock Text="&#xEDA2;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="22" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="20,0,24,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" Foreground="White" FontSize="22"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Detail}" Foreground="#8A92A3" FontSize="14"
                                               Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    <ProgressBar Style="{StaticResource DriveBar}" Margin="0,16,0,0"
                                                 Value="{Binding UsedPercent, Mode=OneWay}"
                                                 Foreground="{Binding UsageBrush}"/>
                                    <TextBlock Text="{Binding StatusText}" Foreground="#FF8A5C" FontSize="13"
                                               Margin="0,10,0,0" TextWrapping="Wrap"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding UsedPercent, StringFormat={}{0:0}%}"
                                               Foreground="White" FontSize="40" FontWeight="SemiBold"
                                               HorizontalAlignment="Right"/>
                                    <TextBlock Text="used" Foreground="#8A92A3" FontSize="14"
                                               HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
