<UserControl x:Class="Gaugr.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="SettingCard" TargetType="Border">
            <Setter Property="Margin" Value="8,0,8,14"/>
            <Setter Property="Padding" Value="26,22"/>
            <Setter Property="CornerRadius" Value="22"/>
            <Setter Property="BorderBrush" Value="#1C2028"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#101218"/>
        </Style>

        <Style x:Key="ChoiceButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#8A92A3"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" CornerRadius="10" Padding="16,9" Background="#161920"
                                BorderBrush="#232733" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1F2330"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2A2D36"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#3A4054"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Switch" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="track" Width="52" Height="30" CornerRadius="15" Background="#232733">
                            <Ellipse x:Name="knob" Width="22" Height="22" Fill="White"
                                     HorizontalAlignment="Left" Margin="4,0,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="#2F6BFF"/>
                                <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="knob" Property="Margin" Value="0,0,4,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StepButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="10" Background="#161920"
                                BorderBrush="#232733" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1F2330"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#343A4D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource StepButton}">
            <Setter Property="Width" Value="Auto"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="8,0,8,18">
            <TextBlock Text="Settings" Foreground="White" FontSize="14"/>
            <TextBlock Text="Make Gaugr yours" Foreground="White" FontSize="38" FontWeight="Light"
                       Margin="0,22,0,0"/>
            <TextBlock Text="Changes are saved automatically" Foreground="#8A92A3" FontSize="15"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="820" HorizontalAlignment="Left">

                <Border Style="{StaticResource SettingCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                            <TextBlock Text="Temperature unit" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="Used for the gauges and summaries. Performance charts always plot in °C."
                                       Foreground="#8A92A3" FontSize="14" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton Content="°C" GroupName="unit" Style="{StaticResource ChoiceButton}"
                                         IsChecked="{Binding IsCelsius, Mode=TwoWay}"/>
                            <RadioButton Content="°F" GroupName="unit" Style="{StaticResource ChoiceButton}"
                                         IsChecked="{Binding IsFahrenheit, Mode=TwoWay}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                            <TextBlock Text="Refresh rate" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="How often sensors are read. Faster updates use a little more CPU. Changing this clears the live graphs."
                                       Foreground="#8A92A3" FontSize="14" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton Content="0.5 s" GroupName="refresh" Style="{StaticResource ChoiceButton}"
                                         IsChecked="{Binding IsRefreshHalfSecond, Mode=TwoWay}"/>
                            <RadioButton Content="1 s" GroupName="refresh" Style="{StaticResource ChoiceButton}"
                                         IsChecked="{Binding IsRefreshOneSecond, Mode=TwoWay}"/>
                            <RadioButton Content="2 s" GroupName="refresh" Style="{StaticResource ChoiceButton}"
                                         IsChecked="{Binding IsRefreshTwoSeconds, Mode=TwoWay}"/>
                            <RadioButton Content="5 s" GroupName="refresh" Style="{StaticResource ChoiceButton}"
                                         IsChecked="{Binding IsRefreshFiveSeconds, Mode=TwoWay}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                            <TextBlock Text="Start with Windows" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="Open Gaugr automatically when you sign in. Uses a scheduled task, so the administrator prompt does not appear at startup."
                                       Foreground="#8A92A3" FontSize="14" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding StartupMessage}" Foreground="#FF8A5C" FontSize="13"
                                       Margin="0,8,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ToggleButton Grid.Column="1" VerticalAlignment="Center"
                                      Style="{StaticResource Switch}"
                                      IsChecked="{Binding StartWithWindows, Mode=TwoWay}"/>
                    </Grid>
                </Border>


                <Border Style="{StaticResource SettingCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                            <TextBlock Text="Compact overlay" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="A small always-on-top panel with CPU, GPU and memory readings. Drag it anywhere and right-click it to close. It shows over windowed and borderless games, but not over exclusive full-screen ones. You can also toggle it from the tray menu."
                                       Foreground="#8A92A3" FontSize="14" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ToggleButton Grid.Column="1" VerticalAlignment="Center"
                                      Style="{StaticResource Switch}"
                                      IsChecked="{Binding OverlayEnabled, Mode=TwoWay}"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                            <TextBlock Text="Keep running in the tray" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="Closing the window hides Gaugr in the system tray instead of quitting, so alerts keep working. Use Exit in the tray menu to quit."
                                       Foreground="#8A92A3" FontSize="14" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ToggleButton Grid.Column="1" VerticalAlignment="Center"
                                      Style="{StaticResource Switch}"
                                      IsChecked="{Binding CloseToTray, Mode=TwoWay}"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingCard}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                <TextBlock Text="Alerts" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="Get a Windows notification when a reading goes over its limit. Each alert shows once, and again only after the reading drops back down. Temperature limits are in °C."
                                           Foreground="#8A92A3" FontSize="14" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" VerticalAlignment="Center"
                                          Style="{StaticResource Switch}"
                                          IsChecked="{Binding AlertsEnabled, Mode=TwoWay}"/>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Thresholds}" Margin="0,18,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Title}" Foreground="White" FontSize="15"
                                                   VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Content="&#x2212;" Style="{StaticResource StepButton}"
                                                    Command="{Binding DecreaseCommand}"/>
                                            <TextBlock Text="{Binding Text}" Width="84" TextAlignment="Center"
                                                       Foreground="White" FontSize="15" VerticalAlignment="Center"/>
                                            <Button Content="+" Style="{StaticResource StepButton}"
                                                    Command="{Binding IncreaseCommand}"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Content="Send test alert" Style="{StaticResource ActionButton}"
                                HorizontalAlignment="Left" Margin="0,16,0,0"
                                Command="{Binding SendTestAlertCommand}"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
