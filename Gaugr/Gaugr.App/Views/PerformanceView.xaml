<UserControl x:Class="Gaugr.App.Views.PerformanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
    <UserControl.Resources>
        <Style x:Key="ChartCard" TargetType="Border">
            <Setter Property="Background" Value="#12151C"/>
            <Setter Property="BorderBrush" Value="#1E232D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="8"/>
        </Style>

        <Style x:Key="RangeButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#8A92A3"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" CornerRadius="8" Padding="12,7" Background="#12151C">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#161A23"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1C2230"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="8,0,8,12">
            <StackPanel>
                <TextBlock Text="Performance" Foreground="White" FontSize="32" FontWeight="SemiBold"/>
                <TextBlock Text="Live history of your PC" Foreground="#8A92A3" FontSize="15"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <RadioButton Content="60 seconds" GroupName="range" IsChecked="True"
                             Style="{StaticResource RangeButton}"
                             Command="{Binding SetWindowCommand}" CommandParameter="60"/>
                <RadioButton Content="5 minutes" GroupName="range"
                             Style="{StaticResource RangeButton}"
                             Command="{Binding SetWindowCommand}" CommandParameter="300"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource ChartCard}" DataContext="{Binding Cpu}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="CPU" Foreground="White" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Summary}" Foreground="#8A92A3" FontSize="13"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="● Usage" Foreground="#288CFF" FontSize="12" Margin="0,0,14,0"/>
                            <TextBlock Text="● Temperature" Foreground="#FFA028" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>
                    <lvc:CartesianChart Grid.Row="1" Background="Transparent" Series="{Binding Series}"
                                        XAxes="{Binding XAxes}" YAxes="{Binding YAxes}"/>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource ChartCard}" DataContext="{Binding Gpu}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="GPU" Foreground="White" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Summary}" Foreground="#8A92A3" FontSize="13"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="● Usage" Foreground="#288CFF" FontSize="12" Margin="0,0,14,0"/>
                            <TextBlock Text="● Temperature" Foreground="#FFA028" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>
                    <lvc:CartesianChart Grid.Row="1" Background="Transparent" Series="{Binding Series}"
                                        XAxes="{Binding XAxes}" YAxes="{Binding YAxes}"/>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource ChartCard}" DataContext="{Binding Ram}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,8">
                    <TextBlock Text="RAM" Foreground="White" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Summary}" Foreground="#8A92A3" FontSize="13"/>
                </StackPanel>
                <lvc:CartesianChart Grid.Row="1" Background="Transparent" Series="{Binding Series}"
                                    XAxes="{Binding XAxes}" YAxes="{Binding YAxes}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>