<Window x:Class="Gaugr.App.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gaugr overlay" Icon="pack://application:,,,/Assets/Gaugr.ico"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        FontFamily="Segoe UI Variable Display, Segoe UI">
    <Border Background="#E60B0D13" BorderBrush="#2A2F3D" BorderThickness="1"
            CornerRadius="16" Padding="18,14" Cursor="SizeAll"
            MouseLeftButtonDown="OnDrag">
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Close overlay" Click="OnClose"/>
            </ContextMenu>
        </Border.ContextMenu>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="CPU" Foreground="#8A92A3" FontSize="13" Margin="0,0,18,6"/>
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CpuValue}" Foreground="White"
                       FontSize="15" FontWeight="SemiBold" TextAlignment="Right" Margin="0,0,0,6"/>

            <TextBlock Grid.Row="1" Text="GPU" Foreground="#8A92A3" FontSize="13" Margin="0,0,18,6"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding GpuValue}" Foreground="White"
                       FontSize="15" FontWeight="SemiBold" TextAlignment="Right" Margin="0,0,0,6"/>

            <TextBlock Grid.Row="2" Text="RAM" Foreground="#8A92A3" FontSize="13" Margin="0,0,18,0"/>
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding RamValue}" Foreground="White"
                       FontSize="15" FontWeight="SemiBold" TextAlignment="Right"/>
        </Grid>
    </Border>
</Window>
