<UserControl x:Class="Gaugr.App.Controls.MetricCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Gaugr.App.Controls"
             x:Name="root">
    <Border Background="#12151C" BorderBrush="#1E232D" BorderThickness="1"
            CornerRadius="16" Padding="24" Margin="8">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Title, ElementName=root}"
                           Foreground="White" FontSize="26" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Subtitle, ElementName=root}"
                           Foreground="#8A92A3" FontSize="14" Margin="0,4,12,0"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <Grid Grid.Column="1" Width="220" Height="220">
                <controls:TickGauge Value="{Binding Value, ElementName=root}"/>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding Value, ElementName=root, StringFormat={}{0:0}}"
                                   Foreground="White" FontSize="44" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Unit, ElementName=root}"
                                   Foreground="#8A92A3" FontSize="16" Margin="2,6,0,0"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Caption, ElementName=root}"
                               Foreground="#8A92A3" FontSize="14"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>