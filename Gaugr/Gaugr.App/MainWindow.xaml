<Window x:Class="Gaugr.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Gaugr.App.ViewModels"
        xmlns:views="clr-namespace:Gaugr.App.Views"
        Title="Gaugr" Height="720" Width="1200"
        Background="#0B0D12" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="NavButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#8A92A3"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" CornerRadius="10" Padding="14,10" Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#161A23"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1C2230"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate DataType="{x:Type vm:OverviewViewModel}">
            <views:OverviewView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PerformanceViewModel}">
            <views:PerformanceView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProcessesViewModel}">
            <views:ProcessesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PlaceholderViewModel}">
            <views:PlaceholderView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="#0F1218" BorderBrush="#1E232D" BorderThickness="0,0,1,0" Padding="16,28">
            <StackPanel>
                <TextBlock Text="Gaugr" Foreground="White" FontSize="28"
                           FontWeight="SemiBold" Margin="14,0,0,24"/>
                <RadioButton Content="Overview" GroupName="nav" IsChecked="True"
                             Style="{StaticResource NavButton}"
                             Command="{Binding NavigateCommand}" CommandParameter="Overview"/>
                <RadioButton Content="Performance" GroupName="nav" Style="{StaticResource NavButton}"
                             Command="{Binding NavigateCommand}" CommandParameter="Performance"/>
                <RadioButton Content="Hardware" GroupName="nav" Style="{StaticResource NavButton}"
                             Command="{Binding NavigateCommand}" CommandParameter="Hardware"/>
                <RadioButton Content="Processes" GroupName="nav" Style="{StaticResource NavButton}"
                             Command="{Binding NavigateCommand}" CommandParameter="Processes"/>
                <RadioButton Content="Storage" GroupName="nav" Style="{StaticResource NavButton}"
                             Command="{Binding NavigateCommand}" CommandParameter="Storage"/>
                <RadioButton Content="Settings" GroupName="nav" Style="{StaticResource NavButton}"
                             Command="{Binding NavigateCommand}" CommandParameter="Settings"/>
            </StackPanel>
        </Border>

        <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" Margin="32"/>
    </Grid>
</Window>